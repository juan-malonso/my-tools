{
  "name": "screen-wall",
  "minify": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "screen-wall.deploy.men/*",
      "zone_name": "deploy.men"
    }
  ]
}
