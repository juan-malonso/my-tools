{
  "name": "team-time",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "NEXT_PRIVATE_STANDALONE=true next build --webpack",
    "deploy": "../../deploy.sh -n team-time",
    "deploy:build": "yarn build && yarn postbuild && yarn deploy",
    "dev": "next dev --webpack",
    "lint": "eslint .",
    "postbuild": "opennextjs-cloudflare build -s",
